{
  "datasets": [
    {
      "name": "d1a00001",
      "displayName": "Chiffres clés",
      "queryLines": [
        "SELECT\n",
        "  round(100 * avg(CASE WHEN est_terminus THEN CAST(a_l_heure AS DOUBLE) END), 1) AS pct_a_l_heure_terminus,\n",
        "  count_if(est_terminus AND a_l_heure IS NOT NULL) AS trains_au_terminus,\n",
        "  round(avg(CASE WHEN est_terminus THEN retard_arrivee_min END), 2) AS retard_moyen_terminus_min,\n",
        "  count(*) AS passages\n",
        "FROM workspace.gold.fait_passage"
      ]
    },
    {
      "name": "d1a00002",
      "displayName": "Ponctualité par jour",
      "queryLines": [
        "SELECT date_jour, nom_jour, type_jour, trains, pct_a_l_heure, retard_moyen_min\n",
        "FROM workspace.gold.v_ponctualite_jour\n",
        "ORDER BY date_jour"
      ]
    },
    {
      "name": "d1a00003",
      "displayName": "Points les moins ponctuels",
      "queryLines": [
        "SELECT nom_nl, arrivees, pct_a_l_heure, retard_moyen_min, retard_median_min\n",
        "FROM workspace.gold.v_ponctualite_gare\n",
        "WHERE arrivees >= 500\n",
        "ORDER BY pct_a_l_heure\n",
        "LIMIT 15"
      ]
    },
    {
      "name": "d1a00004",
      "displayName": "Ponctualité par heure",
      "queryLines": [
        "SELECT heure, type_jour, arrivees, pct_a_l_heure, retard_moyen_min\n",
        "FROM workspace.gold.v_ponctualite_heure\n",
        "WHERE arrivees >= 1000\n",
        "ORDER BY heure"
      ]
    },
    {
      "name": "d1a00005",
      "displayName": "Ponctualité par type de train",
      "queryLines": [
        "SELECT type_train, sum(trains) AS trains,\n",
        "  round(sum(pct_a_l_heure * trains) / sum(trains), 2) AS pct_a_l_heure\n",
        "FROM workspace.gold.v_ponctualite_relation\n",
        "GROUP BY type_train\n",
        "ORDER BY pct_a_l_heure"
      ]
    },
    {
      "name": "d1a00006",
      "displayName": "Jonction Nord-Midi",
      "queryLines": [
        "SELECT zone, 'entre deux points' AS moment, round(retard_pris_en_ligne_min * 60, 1) AS secondes\n",
        "FROM workspace.gold.v_jonction_nord_midi\n",
        "UNION ALL\n",
        "SELECT zone, 'à quai' AS moment, round(retard_pris_a_quai_min * 60, 1) AS secondes\n",
        "FROM workspace.gold.v_jonction_nord_midi"
      ]
    },
    {
      "name": "d1a00007",
      "displayName": "Retard le long du trajet",
      "queryLines": [
        "SELECT rang_arret, arrivees, retard_moyen_min, retard_pris_en_ligne_min, retard_pris_a_quai_min\n",
        "FROM workspace.gold.v_propagation\n",
        "WHERE rang_arret >= 2\n",
        "ORDER BY rang_arret"
      ]
    }
  ],
